
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Hope School" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#17365D">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- Application Assets -->
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-school-white font-body text-gray-800">

    <%= render "shared/navbar" %>

    <% if notice %>
      <div class="bg-green-100 text-green-800 p-4 text-sm text-center font-medium">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="bg-red-100 text-red-800 p-4 text-sm text-center font-medium">
        <%= alert %>
      </div>
    <% end %>

    <main class="min-h-screen">
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>

  </body>
</html>
