    <div class="flex items-center justify-between h-20">

      <!-- School Logo / Name -->
      <div class="flex-shrink-0">
        <%= link_to root_path, class: "text-2xl lg:text-3xl font-extrabold text-[#17365D] tracking-tight" do %>
          Hope<span class="text-[#C83D42]"> School</span>
        <% end %>
        <p class="text-[9px] sm:text-[10px] uppercase tracking-[2px] text-[#2874B8] font-semibold mt-0.5">
