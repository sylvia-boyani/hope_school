            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>

          <svg
            data-mobile-menu-target="closeIcon"
            class="hidden h-8 w-8"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
