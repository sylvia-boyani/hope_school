        <%= link_to "About", about_path, class: "text-[#17365D] hover:text-[#2874B8] font-semibold transition-colors duration-300" %>

        <%= link_to "Programs", programs_path, class: "text-[#17365D] hover:text-[#2874B8] font-semibold transition-colors duration-300" %>

        <%= link_to "Admissions", admissions_path, class: "text-[#17365D] hover:text-[#2874B8] font-semibold transition-colors duration-300" %>

        <%= link_to "Contact", contact_path, class: "text-[#17365D] hover:text-[#2874B8] font-semibold transition-colors duration-300" %>
      </div>

      <!-- Desktop Apply Button -->
      <div class="hidden lg:block">
        <%= link_to "Apply Now", admissions_path, class: "px-7 py-3 bg-[#C83D42] text-white rounded-full font-bold shadow-md hover:bg-[#A92F35] hover:-translate-y-0.5 transition-all duration-300 active:scale-95" %>
